// ReShade reports this in its "Registered add-on ... vX.Y.Z.W" log line, which is how we
// tell which build the user is actually running. (docs/RESEARCH.md §2.1)

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "stray-dlss"
            VALUE "FileDescription",  "DLSS Super Resolution add-on for Stray"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "stray-dlss"
            VALUE "OriginalFilename", "stray-dlss.addon64"
            VALUE "ProductName",      "Stray DLSS"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
